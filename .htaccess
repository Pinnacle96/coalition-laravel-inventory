Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:css|js)/[a-zA-Z0-9_.-]+$ public/$0 [END]
    RewriteRule ^(?:favicon\.ico|robots\.txt)$ public/$0 [END]
    RewriteRule ^(?:\.|(?:app|bootstrap|config|database|public|resources|routes|storage|tests|vendor)(?:/|$)|artisan$|composer\.) - [F,END,NC]
    RewriteRule ^ index.php [END]
</IfModule>
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
